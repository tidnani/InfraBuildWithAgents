# Terraform state files
*.tfstate
*.tfstate.backup
*.tfstate.*.backup

# Terraform provider binaries and lock files managed by .terraform
**/.terraform/providers/

# Terraform plan files
*.tfplan

# Local override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Crash log files
crash.log
crash.*.log

# Sensitive variable files
*.tfvars.json
!environments/*.tfvars

# CLI config file
.terraformrc
terraform.rc
